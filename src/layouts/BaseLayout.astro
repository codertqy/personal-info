---
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchOverlay from '@/components/SearchOverlay.astro';
import { siteConfig } from '@/config/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.socialImage,
  article = false,
  published,
  updated,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? siteConfig.url);
const imageUrl = new URL(image, Astro.site ?? siteConfig.url);
const fullTitle = title === siteConfig.title ? title : `${title} · ${siteConfig.wordmark}`;
const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: imageUrl.href,
      datePublished: published?.toISOString(),
      dateModified: (updated ?? published)?.toISOString(),
      inLanguage: siteConfig.locale,
      author: { '@type': 'Person', name: siteConfig.name },
      mainEntityOfPage: canonical.href,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteConfig.title,
      description: siteConfig.description,
      url: new URL('/', Astro.site ?? siteConfig.url).href,
      inLanguage: siteConfig.locale,
    };
---

<!doctype html>
<html lang="zh-CN" class="motion-pending">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FBF8F1" />
    <link rel="icon" type="image/png" href={siteConfig.logo} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('blog-theme');
        const theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        const firstVisit = !sessionStorage.getItem('blog-motion-seen');
        document.documentElement.classList.remove('motion-pending');
        document.documentElement.classList.add(firstVisit ? 'motion-first' : 'motion-seen');
        if (firstVisit) sessionStorage.setItem('blog-motion-seen', '1');
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <SearchOverlay />
    <script>
      const bindGlobalInteractions = () => {
        const root = document.documentElement;
        const header = document.querySelector<HTMLElement>('[data-site-header]');
        const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
        const menu = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
        const menuOpen = document.querySelector<HTMLButtonElement>('[data-menu-open]');
        const menuClose = document.querySelector<HTMLButtonElement>('[data-menu-close]');

        const syncHeader = () => header?.classList.toggle('is-compact', scrollY > 24);
        syncHeader();
        addEventListener('scroll', syncHeader, { passive: true });

        if (themeButton && !themeButton.dataset.bound) {
          themeButton.dataset.bound = 'true';
          themeButton.setAttribute('aria-label', root.dataset.theme === 'dark' ? '切换到浅色模式' : '切换深色模式');
          themeButton.addEventListener('click', () => {
            const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            localStorage.setItem('blog-theme', next);
            themeButton.setAttribute('aria-label', next === 'dark' ? '切换到浅色模式' : '切换到深色模式');
          });
        }

        const openMenu = () => {
          if (!menu?.open) menu?.showModal();
          document.body.classList.add('scroll-locked');
          menuClose?.focus();
        };
        const closeMenu = () => {
          menu?.close();
          document.body.classList.remove('scroll-locked');
          menuOpen?.focus();
        };

        if (menuOpen && !menuOpen.dataset.bound) {
          menuOpen.dataset.bound = 'true';
          menuOpen.addEventListener('click', openMenu);
          menuClose?.addEventListener('click', closeMenu);
          menu?.addEventListener('click', (event) => {
            if (event.target === menu) closeMenu();
          });
          menu?.addEventListener('cancel', (event) => {
            event.preventDefault();
            closeMenu();
          });
          menu?.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
              event.preventDefault();
              closeMenu();
            }
          });
          menu?.addEventListener('close', () => document.body.classList.remove('scroll-locked'));
        }

        const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          reveals.forEach((node) => node.classList.add('is-visible'));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              });
            },
            { rootMargin: '0px 0px -15% 0px', threshold: 0.04 },
          );
          reveals.forEach((node) => observer.observe(node));
        }
      };

      document.addEventListener('astro:page-load', bindGlobalInteractions);
      bindGlobalInteractions();
    </script>
  </body>
</html>
