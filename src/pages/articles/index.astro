---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleRow from '@/components/ArticleRow.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const categories = [...new Set(articles.map((article) => article.data.category))];
const tags = [...new Set(articles.flatMap((article) => article.data.tags))];
---

<BaseLayout title="文章" description="全部文章、分类与标签。">
  <header class="page-header shell shell--narrow">
    <p class="eyebrow">ARCHIVE · 写作归档</p>
    <h1>文章</h1>
    <p>记录开发中遇到的问题、排查过程和最终方案，也为下一次遇见相似问题留下线索。</p>
  </header>
  <div class="archive-toolbar shell shell--narrow" aria-label="文章筛选">
    <button class="active" type="button" data-filter="all">全部 <span>{articles.length}</span></button>
    {categories.map((category) => <button type="button" data-filter={category}>{category}</button>)}
  </div>
  <section class="archive-list shell shell--narrow" aria-live="polite">
    {articles.map((article, index) => (
      <div data-category={article.data.category}>
        <ArticleRow
          href={`/articles/${article.id.replace(/\.(md|mdx)$/i, '')}/`}
          title={article.data.title}
          description={article.data.description}
          date={article.data.published}
          category={article.data.category}
          image={article.data.image}
          imageAlt={article.data.imageAlt}
          index={index}
        />
      </div>
    ))}
  </section>
  <section class="tag-index shell shell--narrow" data-reveal>
    <h2>按标签浏览</h2>
    <div>{tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>
  </section>

  <script>
    const bindFilters = () => {
      document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
        if (button.dataset.bound) return;
        button.dataset.bound = 'true';
        button.addEventListener('click', () => {
          const selected = button.dataset.filter;
          document.querySelectorAll('[data-filter]').forEach((item) => item.classList.toggle('active', item === button));
          document.querySelectorAll<HTMLElement>('[data-category]').forEach((row) => {
            row.hidden = selected !== 'all' && row.dataset.category !== selected;
          });
        });
      });
    };
    document.addEventListener('astro:page-load', bindFilters);
    bindFilters();
  </script>
</BaseLayout>
