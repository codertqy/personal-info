---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleRow from '@/components/ArticleRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { siteConfig } from '@/config/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);
const noteEntries = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);
const notes = await Promise.all(noteEntries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const formatNoteDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit' }).format(date).replace('/', '.');
---

<BaseLayout>
  <section class="hero shell">
    <figure class="hero__image">
      <img src="/images/hero-editorial.webp" alt="暖色自然光下的书籍、陶杯、纸张和玻璃花瓶" width="1122" height="1402" fetchpriority="high" />
      <figcaption><span>DEV NOTES</span><span>01 — 持续记录</span></figcaption>
    </figure>
    <div class="hero__copy">
      <p class="hero__kicker">天气又不好 · 开发与生活记录</p>
      <h1>把问题写下来，<span>也把答案留下来。</span></h1>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__intro">{siteConfig.description}</p>
      <a class="hero__cta text-link" href="/articles/">阅读最新文章 <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero__motto" aria-label={siteConfig.motto}>
      <span>{siteConfig.motto}</span>
      <Icon name="ph:seal-check" size={24} />
    </div>
  </section>

  <section class="home-section shell" data-reveal>
    <SectionHeading title="最近写作" href="/articles/" linkLabel="查看全部文章" />
    <div class="article-list reveal-children">
      {articles.map((article, index) => (
        <ArticleRow
          href={`/articles/${article.id.replace(/\.(md|mdx)$/i, '')}/`}
          title={article.data.title}
          description={article.data.description}
          date={article.data.published}
          category={article.data.category}
          image={article.data.image}
          imageAlt={article.data.imageAlt}
          index={index}
        />
      ))}
    </div>
  </section>

  <section class="home-section notes-section shell" data-reveal>
    <SectionHeading title="最近日常" href="/notes/" linkLabel="查看全部记录" />
    <div class="note-grid reveal-children">
      {notes.map(({ entry, Content }) => (
        <article class="note-card">
          <div class="note-card__meta">
            <time datetime={entry.data.published.toISOString()}>{formatNoteDate(entry.data.published)}</time>
            <span>{entry.data.mood}</span>
          </div>
          <h3>{entry.data.title}</h3>
          <div class="note-card__body"><Content /></div>
          <ul aria-label="记录标签">{entry.data.tags.map((tag) => <li>#{tag}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
