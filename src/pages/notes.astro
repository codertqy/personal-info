---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const entries = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const notes = await Promise.all(entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date).replaceAll('/', '—');
---

<BaseLayout title="日常" description="生活碎片、学习进度，以及还不够长成一篇文章的想法。">
  <header class="page-header shell shell--narrow">
    <p class="eyebrow">FIELD NOTES · 生活切片</p>
    <h1>日常</h1>
    <p>这里放生活碎片、学习进度，以及还不够长成一篇文章的想法。短一点，也真实一点。</p>
  </header>
  <section class="notes-timeline shell shell--narrow">
    {notes.map(({ entry, Content }, index) => (
      <article class="timeline-note" data-reveal style={`--stagger:${index * 70}ms`}>
        <div class="timeline-note__date">
          <time datetime={entry.data.published.toISOString()}>{formatDate(entry.data.published)}</time>
          <span>{entry.data.mood}</span>
        </div>
        <div class="timeline-note__content">
          <h2>{entry.data.title}</h2>
          {entry.data.image && <img class="timeline-note__image" src={entry.data.image} alt={entry.data.imageAlt || entry.data.title} width="1200" height="800" loading="lazy" />}
          <div class="note-prose"><Content /></div>
          <ul aria-label="记录标签">{entry.data.tags.map((tag) => <li>#{tag}</li>)}</ul>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
