---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects } from '@/data/projects';
---

<BaseLayout title="项目" description="少量公开项目与实践记录。">
  <header class="page-header shell shell--narrow">
    <p class="eyebrow">SELECTED WORK · 实践记录</p>
    <h1>项目</h1>
    <p>记录正在维护的个人项目与其中的实践过程。</p>
  </header>
  <section class="projects-list shell shell--narrow">
    {projects.map((project, index) => (
      <article class="project-row" data-reveal style={`--stagger:${index * 80}ms`}>
        <img src={project.image} alt={project.imageAlt} width="1536" height="1024" />
        <div>
          <p class="eyebrow">{project.status}</p>
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <ul>{project.tags.map((tag) => <li>{tag}</li>)}</ul>
          {project.href ? <a class="text-link" href={project.href}>访问项目 <span aria-hidden="true">→</span></a> : <span class="muted-link">公开链接待填写</span>}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
