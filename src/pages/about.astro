---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
---

<BaseLayout title="关于" description="关于天气又不好与这个影像空间。">
  <section class="about-scene page-shell">
    <figure data-reveal>
      <img src={siteConfig.avatar} alt="天气又不好的头像" width="300" height="300" />
      <figcaption>天气又不好</figcaption>
    </figure>
    <div class="about-scene__copy">
      <p class="eyebrow">ABOUT · 关于</p>
      <h1>不解释天气，<br />只留下经过的光。</h1>
      <p>{siteConfig.bio}</p>
      <p>我主要学习和使用 Web 前端，也在接触 Java、Python、边缘计算与 AI 智能体。这个空间不承担教程或长篇写作，只收藏我愿意留下的画面。</p>
      <nav aria-label="联系方式">
        <a href={siteConfig.github} rel="me"><Icon name="ph:github-logo" size={22} />GitHub</a>
        <a href={`mailto:${siteConfig.email}`}><Icon name="ph:envelope-simple" size={22} />{siteConfig.email}</a>
      </nav>
    </div>
  </section>
</BaseLayout>
