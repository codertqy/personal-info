---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const articles = await getCollection('articles', ({ data }) => !data.draft);
const searchIndex = articles.map((article) => ({
  title: article.data.title,
  description: article.data.description,
  category: article.data.category,
  tags: article.data.tags,
  body: article.body,
  published: article.data.published.toISOString().slice(0, 10),
  href: `/articles/${article.id.replace(/\.(md|mdx)$/i, '')}/`,
}));
---

<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-panel">
    <header>
      <h2 id="search-title">搜索文章</h2>
      <button class="search-close" type="button" data-search-close aria-label="关闭搜索">
        <span>ESC 关闭</span><Icon name="ph:x" size={26} />
      </button>
    </header>
    <div class="search-field">
      <Icon name="ph:magnifying-glass" size={22} />
      <label class="sr-only" for="site-search">输入关键词</label>
      <input id="site-search" type="search" placeholder="搜索标题、摘要与正文" autocomplete="off" data-search-input />
      <button type="button" data-search-clear aria-label="清空搜索"><Icon name="ph:x" size={18} /></button>
    </div>
    <p class="search-summary" data-search-summary>输入关键词，搜索全部文章。</p>
    <div class="search-results" data-search-results role="listbox" aria-label="搜索结果"></div>
  </div>
</dialog>

<script is:inline define:vars={{ searchIndex }}>
  (() => {
    const normalize = (value) => String(value || '').toLocaleLowerCase('zh-CN').replace(/\s+/g, ' ').trim();
    const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]);

    const bindSearch = () => {
      const dialog = document.querySelector('[data-search-dialog]');
      if (!dialog || dialog.dataset.bound) return;
      dialog.dataset.bound = 'true';
      const input = dialog.querySelector('[data-search-input]');
      const results = dialog.querySelector('[data-search-results]');
      const summary = dialog.querySelector('[data-search-summary]');
      const close = dialog.querySelector('[data-search-close]');
      const clear = dialog.querySelector('[data-search-clear]');
      let selected = -1;
      let timer;

      const openSearch = () => {
        if (!dialog.open) dialog.showModal();
        document.body.classList.add('scroll-locked');
        requestAnimationFrame(() => setTimeout(() => input.focus(), 320));
      };
      const closeSearch = () => {
        dialog.classList.add('is-closing');
        setTimeout(() => {
          dialog.close();
          dialog.classList.remove('is-closing');
          document.body.classList.remove('scroll-locked');
        }, 180);
      };
      const render = () => {
        const query = normalize(input.value);
        selected = -1;
        if (!query) {
          summary.textContent = '输入关键词，搜索全部文章。';
          results.innerHTML = '';
          return;
        }
        const matches = searchIndex.filter((item) => normalize([item.title, item.description, item.category, item.tags.join(' '), item.body].join(' ')).includes(query));
        summary.innerHTML = matches.length
          ? `找到 <strong>${matches.length}</strong> 篇相关文章`
          : '没有找到相关文章。';
        results.innerHTML = matches.length
          ? matches.map((item, index) => `<a role="option" aria-selected="false" data-result="${index}" href="${item.href}"><strong>${escapeHtml(item.title)}</strong><span>${escapeHtml(item.category)}</span><time>${item.published}</time></a>`).join('')
          : '<div class="search-empty"><p>换一个关键词试试，或浏览全部文章。</p><a href="/articles/">查看全部文章 →</a></div>';
      };
      const move = (direction) => {
        const options = [...results.querySelectorAll('[data-result]')];
        if (!options.length) return;
        selected = (selected + direction + options.length) % options.length;
        options.forEach((option, index) => option.setAttribute('aria-selected', String(index === selected)));
        options[selected].scrollIntoView({ block: 'nearest' });
      };

      document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', openSearch));
      close.addEventListener('click', closeSearch);
      clear.addEventListener('click', () => { input.value = ''; render(); input.focus(); });
      input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(render, 120); });
      dialog.addEventListener('cancel', (event) => { event.preventDefault(); closeSearch(); });
      dialog.addEventListener('click', (event) => { if (event.target === dialog) closeSearch(); });
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') { event.preventDefault(); closeSearch(); }
        if (event.key === 'ArrowDown') { event.preventDefault(); move(1); }
        if (event.key === 'ArrowUp') { event.preventDefault(); move(-1); }
        if (event.key === 'Enter' && selected >= 0) results.querySelector(`[data-result="${selected}"]`)?.click();
      });
      document.addEventListener('keydown', (event) => {
        const typing = ['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '') || document.activeElement?.isContentEditable;
        if (event.key === '/' && !typing && !dialog.open) { event.preventDefault(); openSearch(); }
      });
    };
    document.addEventListener('astro:page-load', bindSearch);
    bindSearch();
  })();
</script>
