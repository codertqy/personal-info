---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config/site';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: '首页' },
  { href: '/gallery/', label: '图库' },
  { href: '/about/', label: '关于' },
];
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header" data-site-header>
  <a class="site-identity" href="/" aria-label={`${siteConfig.wordmark}首页`} data-astro-prefetch>
    <img src={siteConfig.avatar} alt="" width="300" height="300" />
    <span>{siteConfig.wordmark}</span>
  </a>

  <span class="site-header__line" aria-hidden="true"></span>

  <nav class="desktop-nav" aria-label="主导航">
    {links.map((link) => (
      <a class:list={['nav-link', { active: isActive(link.href) }]} href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} data-astro-prefetch>
        {link.label}
      </a>
    ))}
  </nav>

  {path === '/' && (
    <div class="sidebar-drag-hint" aria-hidden="true">
      <Icon name="ph:hand-grabbing" size={27} />
      <span>拖动浏览<small>DRAG TO EXPLORE</small></span>
    </div>
  )}

  <button class="menu-trigger" type="button" data-menu-open aria-label="打开菜单">
    <Icon name="ph:list" size={28} />
  </button>
</header>

<dialog class="mobile-menu" data-mobile-menu aria-labelledby="mobile-menu-title">
  <div class="mobile-menu__sheet">
    <div class="mobile-menu__top">
      <span id="mobile-menu-title">导航</span>
      <button type="button" data-menu-close aria-label="关闭菜单"><Icon name="ph:x" size={28} /></button>
    </div>
    <nav aria-label="移动端主导航">
      {links.map((link, index) => (
        <a class:list={['mobile-nav-link', { active: isActive(link.href) }]} href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} data-astro-prefetch>
          <span>0{index + 1}</span>{link.label}
        </a>
      ))}
    </nav>
    <p>{siteConfig.motto}</p>
  </div>
</dialog>
